PORT=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
PROFILE_ENCRYPTION_KEY=
PRIVATE_PEM_B64=
VERIFY_PRIVATE_PEM_B64=

# Inbound: token a local dev/relay server must send as ?token= to open
# wss://<host>/api/ws/local. Leave unset to disable inbound WebSocket.
WS_SHARED_SECRET=

# Outbound: this server dialing out to a local relay server as a WS client
# (e.g. one exposed via ngrok during development).
LOCAL_WS_URL=
LOCAL_WS_ENABLED=false

# Hostname used when building /networking-url and /short-url response
# links, overriding the generating request's own host. Leave unset to keep
# using req.get("host") (old behavior).
PUBLIC_LINK_DOMAIN=